# Copy to .env and fill in. Never commit the real .env — it is git-ignored.

# --- Database ---
# Postgres via Docker Compose. Matches the POSTGRES_* values in docker-compose.yml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/metering

# --- Stripe (TEST MODE ONLY — never switch to live mode) ---
# Test secret key from https://dashboard.stripe.com/test/apikeys  (starts with sk_test_)
STRIPE_SECRET_KEY=sk_test_replace_me

# Webhook signing secret. Get it from `stripe listen --print-secret`
# or from Dashboard -> Developers -> Webhooks. Starts with whsec_.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Price ID for the Pro plan, from Dashboard -> Products in TEST mode (starts with price_).
# Seeded into plans.stripe_price_id.
STRIPE_PRO_PRICE_ID=price_replace_me

# --- App ---
# Public base URL of this service. Used to build the Stripe Checkout success/cancel
# redirect URLs, so it must be reachable from the browser (not from the webhook).
APP_BASE_URL=http://localhost:8004
